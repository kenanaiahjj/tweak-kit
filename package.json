{
  "name": "ui-tweak-kit",
  "version": "0.1.0",
  "description": "Figma-style visual tweaks in the browser, applied to the source by Claude Code",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    "./vite": {
      "types": "./vite-plugin.d.mts",
      "default": "./vite-plugin.mjs"
    },
    "./server": "./server-core.mjs",
    "./overlay.js": "./overlay.js"
  },
  "bin": {
    "ui-tweaks-serve": "./serve.mjs"
  },
  "files": [
    "direct-apply.mjs",
    "update.mjs",
    "overlay.js",
    "serve.mjs",
    "server-core.mjs",
    "vite-plugin.d.mts",
    "vite-plugin.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenanaiahjj/tweak-kit.git"
  }
}
